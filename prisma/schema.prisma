generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  PARTNER
  PLANNER
  CLIENT
}

enum LeadStatus {
  NEW
  CONTACTED
  VISIT_SCHEDULED
  PROPOSAL_SENT
  BOOKED
  ARCHIVED
  LOST
}

enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

enum PaymentMethod {
  UPI
  BANK_TRANSFER
  CASH
  CHEQUE
  CARD
}

enum PaymentType {
  ADVANCE_DEPOSIT
  MID_MILESTONE
  FINAL_BALANCE
  ADDITIONAL_SERVICE
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  phone     String
  email     String
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  users     User[]
  leads     Lead[]
  auditLogs AuditLog[]

  @@map("organizations")
}

model User {
  id           String    @id @default(uuid())
  orgId        String    @map("org_id")
  email        String    @unique
  phone        String?
  fullName     String    @map("full_name")
  role         UserRole  @default(PLANNER)
  passwordHash String?   @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assignedLeads Lead[]      @relation("AssignedLeads")
  siteVisits    SiteVisit[] @relation("AssignedVisits")
  recordedPayments Payment[] @relation("RecordedPayments")
  auditLogs     AuditLog[]

  @@map("users")
}

model Lead {
  id             String     @id @default(uuid())
  orgId          String     @map("org_id")
  clientName     String     @map("client_name")
  clientPhone    String     @map("client_phone")
  clientEmail    String?    @map("client_email")
  occasionType   String     @map("occasion_type")
  targetDate     DateTime?  @map("target_date")
  venueName      String?    @map("venue_name")
  venueCity      String?    @map("venue_city")
  guestCount     Int?       @map("guest_count")
  budgetRange    String?    @map("budget_range")
  notes          String?
  status         LeadStatus @default(NEW)
  assignedUserId String?    @map("assigned_user_id")
  metadata       Json       @default("{}")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assignedTo   User?        @relation("AssignedLeads", fields: [assignedUserId], references: [id], onDelete: SetNull)
  siteVisits   SiteVisit[]
  proposals    Proposal[]
  payments     Payment[]

  @@index([orgId, status])
  @@map("leads")
}

model SiteVisit {
  id                   String   @id @default(uuid())
  leadId               String   @map("lead_id")
  assignedToId         String?  @map("assigned_to")
  scheduledStart       DateTime @map("scheduled_start")
  scheduledEnd         DateTime @map("scheduled_end")
  locationAddress      String   @map("location_address")
  googleCalendarEventId String?  @map("google_calendar_event_id")
  notes                String?
  siteMeasurements     Json     @default("{}") @map("site_measurements")
  completed            Boolean  @default(false)
  createdAt            DateTime @default(now()) @map("created_at")

  lead       Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedTo User? @relation("AssignedVisits", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@map("site_visits")
}

model Proposal {
  id              String         @id @default(uuid())
  leadId          String         @map("lead_id")
  version         Int            @default(1)
  status          ProposalStatus @default(DRAFT)
  totalAmount     Decimal        @map("total_amount") @db.Decimal(12, 2)
  depositRequired Decimal        @map("deposit_required") @db.Decimal(12, 2)
  lineItems       Json           @map("line_items")
  validUntil      DateTime       @map("valid_until")
  clientSignature String?        @map("client_signature")
  signedAt        DateTime?      @map("signed_at")
  createdAt       DateTime       @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("proposals")
}

model Payment {
  id            String        @id @default(uuid())
  leadId        String        @map("lead_id")
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod @default(UPI)
  paymentType   PaymentType   @default(ADVANCE_DEPOSIT) @map("payment_type")
  referenceNote String?       @map("reference_note")
  recordedById  String?       @map("recorded_by_id")
  receivedAt    DateTime      @default(now()) @map("received_at")
  createdAt     DateTime      @default(now()) @map("created_at")

  lead       Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  recordedBy User? @relation("RecordedPayments", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@map("payments")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  orgId      String?  @map("org_id")
  userId     String?  @map("user_id")
  entityName String   @map("entity_name")
  entityId   String   @map("entity_id")
  action     String
  changes    Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orgId, entityName])
  @@map("audit_logs")
}
